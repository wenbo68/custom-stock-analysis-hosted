# Standalone tiered-analysis app — configuration.
# Copy to .env and fill in what you use. Everything is optional except the
# LLM model: without LITELLM_MODEL an analysis run refuses to start.

# ============================================================
# LLM
# ============================================================
# On the public server every signed-in user picks a model and stores
# their own key in the user block; these server-level values only feed
# the CLI script and local runs without an account.
# Model name in litellm format, e.g. "gemini/gemini-3.8-flash",
# "openai/gpt-5.6-luna", "deepseek/deepseek-flash". The matching provider
# API key must also be set (GEMINI_API_KEY / OPENAI_API_KEY /
# DEEPSEEK_API_KEY ... — whatever your provider's standard variable is).
# LITELLM_MODEL=
# GEMINI_API_KEY=

# Optional separate (cheaper/faster) model for the company-news article
# screening step. Falls back to LITELLM_MODEL when unset.
# NEWS_SCREEN_MODEL=

# ============================================================
# Report data sources (all optional — each one upgrades a card)
# ============================================================
# These are the server-wide defaults every run uses; a signed-in user
# may override any of them with their own key in the user block.
# Finnhub (free tier is fine): company-news card fetches by date range
# instead of Yahoo; also a consensus fallback for the opinion data.
# https://finnhub.io/register
# FINNHUB_API_KEY=

# AlphaVantage (free tier 25 calls/day): world-news card fetches by date
# range. https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# FRED (free): macro-economics card (rates, inflation, jobs).
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# SEC EDGAR's free API asks callers to identify themselves — any
# descriptive string with a contact; used by the US fundamentals card.
# SEC_EDGAR_USER_AGENT=my-app contact@example.com

# ============================================================
# Sizing defaults (pre-fill the run form; the form can override per run)
# ============================================================
# TIERED_SIZING_CAPITAL=100000
# TIERED_SIZING_RISK_FRACTION=0.01
# TIERED_SIZING_REWARD_RISK=2

# ============================================================
# Run queue
# ============================================================
# How many analyses may run at the same time, across all users; the rest
# wait in line (first come, first served) and start by themselves. Each
# run holds data and LLM replies in memory, so keep this small on a
# small host — 2 fits Render's free 512 MB service. Whole number >= 1.
# TIERED_MAX_CONCURRENT_RUNS=2

# ============================================================
# Sign-in (public server)
# ============================================================
# Users sign in with Google or Discord. Create an OAuth app at each
# provider and register the callback URL
#   <your site>/api/auth/callback/google   and/or   .../callback/discord
# A provider with no credentials is simply not offered on the sign-in
# block. Google: https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
#
# Secret that signs the login cookie. REQUIRED on the public host (a
# missing value gets a random one, which signs everyone out on restart).
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
#
# Secret that encrypts the users' stored API keys (Fernet). REQUIRED
# for the user block to save keys; changing it makes stored keys
# unreadable, so keep it. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=
#
# The site's public address, used to build the OAuth callback URL when a
# proxy hides it (Render: https://<service>.onrender.com).
# PUBLIC_BASE_URL=
#
# Login cookie over HTTPS only — on by default when hosted (PORT set).
# SESSION_COOKIE_SECURE=true
#
# Other sites allowed to call the API (comma list). Leave unset: the web
# page is served from the same origin and needs no CORS.
# CORS_ALLOW_ORIGINS=

# ============================================================
# Hosting
# ============================================================
# Local runs keep everything in a sqlite file (DATABASE_PATH). A public
# host wipes its disk on every restart, so point the app at a Postgres
# database instead (Neon, Railway, ...) — the URL they hand out works
# as-is. When DATABASE_URL is set, DATABASE_PATH is ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_PATH=./data/stock_analysis.db
#
# Hosting platforms pass PORT and the server then listens on every
# interface; locally it stays on 127.0.0.1:8000 unless overridden.
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
#
# More knobs exist with sensible defaults and are honored but not listed
# here: sqlite tuning (SQLITE_WAL_ENABLED, SQLITE_BUSY_TIMEOUT_MS). See
# src/config.py for the full list.
