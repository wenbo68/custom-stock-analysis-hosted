# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# discord oauth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# auth secret (signs the session cookies so they cannot be forged)
AUTH_SECRET=

# encrypts the user's api keys before they are stored in the db
# changing it makes every api keys stored in db unreadable
API_KEY_ENCRYPTION_KEY=

# site url (used to build oauth callback url)
# Leave blank locally
# on Render set it to: https://<your-service>.onrender.com
PUBLIC_BASE_URL=

# db url
# Leave blank locally (the app keeps a sqlite file at `./data/stock_analysis.db`)
DATABASE_URL=

# how many concurrent runs allowed (extra runs will be queued)
MAX_CONCURRENT_RUNS=

# for fundamentals card
SEC_EDGAR_USER_AGENT=random-name (random@email.com)
# for macro econ card
FRED_API_KEY=
# for company news card
FINNHUB_API_KEY=
# for world news card
ALPHAVANTAGE_API_KEY=